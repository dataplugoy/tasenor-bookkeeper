# Build context is the repository root. Keep the image lean and reproducible:
# copy source only, never host build artifacts — pnpm reinstalls inside the image.
**/node_modules
**/dist
**/.turbo
.git
.github
**/*.log

# The backend catalog is regenerated at boot; the frontend catalog is committed source.
apps/bookkeeper-api/src/plugins/index.json
apps/bookkeeper-api/src/plugins/workspace

# Test/CI outputs.
e2e/cypress/screenshots
e2e/cypress/videos
e2e/cypress/downloads

# Local state and settings, never part of an image. The server's .state holds the
# key that signs access tokens; without it the server generates a new one at start.
apps/bookkeeper-api/.state
apps/bookkeeper-api/*.tasenor
.claude
